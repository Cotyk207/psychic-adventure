{
  "name": "psychic",
  "version": "1.0.1",
  "description": "PSYCHIC — киберпанк ИИ-ассистент для Windows с полным доступом к ПК",
  "main": "src/main/index.cjs",
  "author": "PSYCHIC",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Cotyk207/psychic-adventure",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "preview": "vite preview",
    "smoke": "vite build --config scripts/vite.smoke.config.js && node scripts/smoke-render.mjs",
    "check": "node scripts/check-syntax.mjs",
    "assets": "python3 scripts/generate-assets.py"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "3.1.7",
    "highlight.js": "11.10.0",
    "lucide-react": "0.468.0",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "jsdom": "^31.0.1",
    "vite": "5.4.11",
    "wait-on": "8.0.0"
  },
  "build": {
    "appId": "com.psychic.app",
    "productName": "PSYCHIC",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/wallpapers",
        "to": "wallpapers"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PSYCHIC",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PSYCHIC-Portable-${version}.${ext}"
    }
  }
}
